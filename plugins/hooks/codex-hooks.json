{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora hook-check --agent codex --format codex --event SessionStart --record-session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora hook-check --agent codex --format codex --event UserPromptSubmit --record-session",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora hook-check --agent codex --format codex --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agora hook-check --agent codex --format codex --event Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
